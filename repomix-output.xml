.leaderboard-title {
  color: #ffffff;
  font-size: 30px !important;
  font-weight: 700;
  /* INCREASED MARGIN-BOTTOM from 25px to 45px for more padding above podiums */
  margin: 0 0 45px 0;
}

/* Podium Container (Top 3 Side-by-Side Boxes) */
.podium-container {
  display: flex;
  gap: 16px;
  width: 100%;
  margin-bottom: 25px;
}

.podium-box {
  flex: 1;
  background: rgba(255, 255, 255, 0.07);
  border: 1px solid rgba(255, 255, 255, 0.15);
