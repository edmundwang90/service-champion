/* ==========================================
   CSS VARIABLES FOR FLAWLESS SCALING
   ========================================== */
:root {
  --card-padding: 24px;
  --title-size: 24px;
  --form-gap: 15px;
}

/* Ensure full height reset and apply background image edge-to-edge */
body, html, #root {
  margin: 0;
  padding: 0;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh; /* Safari fix: dynamically adjusts for the address/tab bar */
  background-color: #002b2e;
  background-image: linear-gradient(rgba(0, 93, 99, 0.4), rgba(0, 93, 99, 0.4)), url('./cabin.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  background-attachment: fixed;
}

/* Base Container for the full page - Bulletproof Centering */
.landing-container {
  display: flex;
  flex-direction: column; 
  min-height: 100vh;
  min-height: 100dvh; 
  width: 100%;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  padding: 15px; 
  box-sizing: border-box;
  transition: padding 0.3s ease; 
  overflow-y: auto; 
}

/* Glassmorphism Card - SMALLER AND COMPACT */
.landing-card {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-radius: 20px; 
  border: 1px solid rgba(255, 255, 255, 0.2);
  box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
  padding: var(--card-padding); 
  width: 100%;
  max-width: 600px; 
  color: #ffffff;
  text-align: center;
  box-sizing: border-box;
  margin: auto; 
}

.form-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
}

/* --- Banner Image Styles --- */
.banner-container {
  margin: calc(var(--card-padding) * -1) calc(var(--card-padding) * -1) var(--form-gap) calc(var(--card-padding) * -1); 
  width: calc(100% + (var(--card-padding) * 2)); 
  display: block; 
}

.service-champion-img {
  width: 100%;
  height: auto;
  border-radius: 20px 20px 0 0; 
  display: block;
}

/* Header Badge styling */
.header-badge {
  background: rgba(255, 255, 255, 0.15);
  padding: 4px 12px;
  border-radius: 20px;
  font-size: 15px; 
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.landing-title {
  font-size: var(--title-size); 
  font-weight: 700;
  margin: 0 0 4px 0;
  letter-spacing: -0.5px;
  color: white !important;
}

.landing-subtitle {
  font-size: 13px;
  color: rgba(255, 255, 255, 0.8);
  margin: 0 0 15px 0; 
}

.error-message {
  width: 100%;
  background: rgba(255, 77, 79, 0.2);
  border: 1px solid rgba(255, 77, 79, 0.5);
  color: #ffcccc;
  padding: 10px;
  border-radius: 8px;
  margin-bottom: 15px;
  font-size: 13px;
  font-weight: 500;
  box-sizing: border-box;
}

.landing-form {
  width: 100%;
  /* WIDER FORM: Increased from 400px to 500px */
  max-width: 500px; 
  margin: 0 auto;
}

.form-group {
  margin-bottom: 15px; 
  text-align: left;
  width: 100%;
}

.form-label {
  display: block;
  margin-bottom: 6px;
  font-size: 15px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.9);
}

.form-input {
  width: 100%;
  /* TALLER INPUT: Increased padding from 10px 14px */
  padding: 16px 18px; 
  background: rgba(255, 255, 255, 0.08);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  color: #ffffff;
  /* LARGER TEXT: Increased from 14px to 16px */
  font-size: 16px; 
  box-sizing: border-box;
  outline: none;
  transition: all 0.3s ease;
  font-family: inherit;
  resize: vertical; /* Only applies if you change the HTML tag to a textarea */
}

.form-input::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.form-input:focus {
  background: rgba(255, 255, 255, 0.12);
  border-color: rgba(255, 255, 255, 0.5);
  box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.05);
}

.btn-submit {
  width: 100%;
  /* TALLER BUTTON: Matches the new input height */
  padding: 16px; 
  margin-top: 5px;
  background-color: #005D63 !important;
  color: #ffffff;
  border: none;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
  -webkit-tap-highlight-color: transparent; 
}

.btn-submit:hover {
  transform: translateY(-2px);
  background-color: #f0f4f4;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
}

.btn-submit:active {
  transform: translateY(1px);
}

/* ==========================================
   RESPONSIVE DESIGN FOR IPHONES & IPADS
   ========================================== */
@media screen and (max-width: 1024px) {
  .landing-container {
    padding: 15px;
  }
  
  @media (pointer: coarse) {
    .landing-container:focus-within {
      padding-bottom: 35dvh; 
      padding-top: 5dvh; 
    }
  }
}

/* ==========================================
   LANDSCAPE ORIENTATION (iPads & Tablets)
   ========================================== */
@media screen and (max-height: 850px) and (orientation: landscape) {
  :root {
    --card-padding: 18px; 
    --title-size: 22px;
  }

  .landing-container:focus-within {
    padding-bottom: 50dvh; 
    padding-top: 2dvh; 
  }
}

/* ==========================================
   MOBILE SCREENS
   ========================================== */
@media screen and (max-width: 480px) {
  :root {
    --card-padding: 16px; 
    --title-size: 22px;
  }
}

/* Extreme Mobile Landscape (Phones turned sideways) */
@media screen and (max-height: 500px) and (orientation: landscape) {
  .service-champion-img, .banner-container {
    display: none; 
  }
  
  .landing-container {
    padding: 10px;
  }
  
  .form-input, .btn-submit {
    /* Slightly compress the larger inputs on extremely short sideways screens */
    padding: 12px 14px; 
  }
}
